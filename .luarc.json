{
  "$schema": "https://raw.githubusercontent.com/sumneko/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "Lua 5.4"
  },
  "diagnostics": {
    "globals": ["smelt"],
    "disable": [
      "duplicate-doc-field",
      "redundant-parameter",
      "param-type-mismatch",
      "assign-type-mismatch",
      "undefined-field",
      "lowercase-global",
      "return-type-mismatch",
      "inject-field"
    ]
  },
  "workspace": {
    "library": ["runtime/lua/smelt/_meta"],
    "checkThirdParty": false
  }
}
