package "crate: smelt-term  (pure renderer — TUI library)" as UI #E6F1FF {

  package "primitives" as P #F4F8FF {
    class Cell
    class Grid <<terminal frame>>
    class GridSlice <<direct cell-write slice>> {
      set(row, col, char, style)
      put_str(row, col, s, style)
      fill_rect(rect, char, style)
      width() / height()
      ' Exposed as Lua userdata (P12.A).
      ' Lifetime guarded by SliceGuard (TLS).
    }
    class Rect
    class CellUpdate
    class Flush <<diff → SGR writer>>
    class Compositor <<double-buffered>>
    class SnapshotFrame
    class HitRegistry <<HitRegistry<P>\nhost-defined payload>>
    class Line
    class Span
    class Surface <<smelt-term facade — P11.C>> {
      compositor: Compositor
      theme:      Arc<Theme>
      layout:     LayoutTree
      size:       (u16, u16)
      --
      render<W, F>(w, paint: F)
        where F: FnMut(PaintId,
               &mut GridSlice, &Arc<Theme>)
      ' Non-editor consumers (tcloc) use
      ' this facade; supply their own paint
      ' closure rather than registering into
      ' a table. No register_paint method.
    }
  }

' These three sub-packages logically live in smelt-edit (Window, Ui,
' overlays, interaction contracts) but they're nested under the same
' top-level package as smelt-term so the inheritance / composition
' arrows stay readable on screen. Crate boundary is: anything
' referencing Window / Ui / Overlay / vim is `smelt-edit`; anything
' referencing only LayoutTree / Grid / Compositor / Line is
' `smelt-term`.

  package "parser impls  (tui-side BufferParsers)" as C #F4F8FF {
    class "MarkdownParser"        as PARSEMD <<BufferParser>> {
      Parser **trait** + Buffer
      type live in core. These
      impls live in tui because
      they pull from
      tui::content::highlight::*
      (syntect, inline markdown,
      diff LCS — heavy crates).
    }
    class "DiffParser"            as PARSEDF <<BufferParser>>
    class "SyntaxParser"          as PARSESY <<BufferParser>>
    class "block-variant parsers" as PARSEBL <<User / Thinking / Text /\nCodeLine / ToolCall / Exec\n→ writes per-block Buffer>>
  }

  package "interaction contracts  (smelt-edit)" as IX #DCEAFF {
    interface UiHost <<TuiApp impl>> {
      ui()    : &mut Ui
      focus(win: WinId)
      buf_create / buf_mut
      win_open / win_close / win_mut
      overlay_open
      ' viewport_for / rows_for /
      ' breaks_for are transitional
      ' escape hatches while prompt /
      ' transcript still have core-owned
      ' projections. Target is to
      ' shrink or delete them.
      ' Ui-shaped surface only.
      ' Lua bindings under
      ' smelt.ui / smelt.win /
      ' smelt.buf / smelt.statusline
      ' require UiHost; calling them
      ' from a HeadlessApp errors.
      ' Host-tier bindings reach
      ' &mut Core directly via the
      ' CORE_PTR TLS slot — no Host
      ' trait. No request_redraw —
      ' rendering is event-driven
      ' + diff-based.
    }
    enum Event {
      Key(KeyEvent)
      Mouse(MouseEvent)
      Resize
      Focus / Blur
    }
    enum Status {
      Consumed / Capture / Ignored
      ' No Yank payload — handlers call
      ' Host clipboard directly.
    }
    enum WinEvent {
      Open / Close
      FocusGained / Lost
      Submit / Dismiss
      Select(idx)
      TextChanged
    }
    enum FocusTarget <<keyboard-focus>> {
      Window(WinId)
    }
    enum HitTarget <<mouse/capture>> {
      Window(WinId)
      Scrollbar(owner: WinId)
      Chrome(owner: OverlayId)
    }
    enum VimMode {
      Normal / Insert / Visual
      / VisualLine
      ' UI-local text-editing mode.
      ' Owned by App, defined in ui.
      ' Never crosses engine boundary.
    }
  }

  package "concrete interactive unit  (smelt-edit)" as L #DCEAFF {
    class Window <<buffer viewport>> {
      WinId, BufId
      cursor: (line, col)
      scroll_top: usize
      selection: Option<Range>
      keymap: KeymapId        ' recipe id
      focusable: bool
      --
      render(buf, grid)
      handle(event, ctx, host) -> Status
      cursor() : Option<(x,y)>
    }
  }

  package "layout + composition  (smelt-term)" as LO #F4F8FF {
    class LayoutTree {
      Vbox { gap, chrome, items }
      Hbox { gap, chrome, items }
      Leaf(PaintId)       ' opaque host id
      Item = (Constraint, LayoutTree)
      ' PaintId is u64; smelt-term assigns
      ' no semantics to it. The editor
      ' (smelt-edit) maps PaintId → WinId
      ' via `From<WinId> for PaintId` and
      ' dispatches in `Ui::render` via a
      ' PaintDispatch closure.
      ' Any container can carry chrome
      ' (border + title). Convention is to
      ' use it on overlays only; the type
      ' system allows it anywhere.
    }
    enum Constraint {
      Length(u16)
      Percentage(u16)
      Ratio(u16, u16)
      Min(u16) / Max(u16)
      Fill
      Fit
    }
    class BlockLayout <<tool render>> {
      Leaf(BufId)
      Vbox(Vec<BlockLayout>)
      Hbox(Vec<HboxItem>)
      ' Returned by a tool's
      ' render(args, output, ctx).
      ' Composer replays leaves into
      ' the surrounding LineBuilder;
      ' 1×1 leaves auto-repeat to
      ' fill their allocated rect
      ' (gives sep for free).
    }
    class HboxItem {
      constraint: BlockConstraint
      layout: BlockLayout
    }
    enum BlockConstraint {
      Length(u16)
      Fill(u16)
    }
    enum BorderStyle {
      Single | Double | Rounded
    }
    class BorderSides <<edge bitflag>> {
      top:    bool
      right:  bool
      bottom: bool
      left:   bool
      ALL | NONE | TOP
    }
    class Border {
      style: BorderStyle
      sides: BorderSides
      ' missing sides paint nothing
      ' AND don't reserve a row/col;
      ' corners only when both adjacent
      ' sides are on (otherwise the lone
      ' edge runs full extent with the
      ' straight glyph).
      ' Title is always inset by 1 cell
      ' from each end of the top edge so
      ' the leading cell stays painted by
      ' the corner / horizontal bar.
    }
    enum Anchor {
      Screen(Center)
      Screen { row, col }
      Cursor(Edge)
      Win { target: PaintId,
            attach: Corner }
    }
  }

  package "overlays  (smelt-edit)" as OV #DCEAFF {
    class Overlay <<placement + modality>> {
      layout: LayoutTree     ' chrome (if any)
                              ' lives in here
      anchor: Anchor
      z:      u16
      modal:  bool
    }
  }

  class Ui <<smelt-edit facade>> {
    bufs:     Map<BufId, Buffer>
    wins:     Map<WinId, Window>
    splits:   LayoutTree         ' base layer
    overlays: Vec<Overlay>       ' z-ordered
    focus:    Option<WinId>      ' semantic keyboard focus
    focus_history: Vec<WinId>
    capture:  Option<HitTarget>  ' mouse drag capture
    cursor_shape:  CursorShape   ' single global
    theme, callbacks
    ' pub(crate) mouse dispatch state:
    ' hit index, capture, last_click,
    ' autoscroll_since
    --
    buf_create / buf_mut
    win_open / win_close / win_mut
    overlay_open / overlay_close
    dispatch_event / render
    --
    focus() -> Option<WinId>
    set_focus(win) -> bool
    focused_window() / focused_window_mut()
    focused_overlay() -> Option<OverlayId>
    active_modal() -> Option<OverlayId>
    hit_test(row,col) -> Option<HitTarget>
    focus_next / focus_prev   ' modal-aware
  }

}

