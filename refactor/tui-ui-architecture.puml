' crate: core — headless-safe runtime (Core + capabilities)
' =====================================================================
package "crate: core  (headless-safe runtime)" as CORE #FFF6E0 {

  class Core <<headless-safe coordinator>> {
    config:        AppConfig
    session:       Session
    confirms:      Confirms
    clipboard:     Clipboard
    timers:        Timers
    cells:         Cells
    engine:        EngineClient
    frontend:      FrontendKind
    skills:        Option<Arc<SkillLoader>>
    files:         FileStateCache
    processes:     ProcessRegistry
    ' LuaRuntime lives in tui; core owns
    ' the shared state (LuaShared) and
    ' task runtime (LuaTaskRuntime).
    --
    runs the event loop
    inherent accessor methods
    (cells / timers / engine /
    session / files / processes /
    confirms / config / clipboard
    / skills / frontend) — no
    trait, just direct field
    access.
    ' Shared by TuiApp + HeadlessApp.
  }

  class HeadlessApp <<no-Ui frontend>> {
    core: Core
    sink: HeadlessSink     ' JSON / text out
    --
    Host-tier Lua bindings reach
    through `&mut Core` via the
    `try_with_core` TLS slot.
    UiHost-tier bindings (ui /
    win / buf / statusline) error
    when invoked from headless.
  }

  package "subsystems  (owned by Core)" as SUB #FFF1C8 {
    class AppConfig
    class Session {
      history:    Vec<Message>
      costs:      CostTracker
      turn_metas: Vec<TurnMeta>
      ' Sub-agent state lives in Lua
      ' (cells driven by core::process
      ' background-registry events),
      ' not here.
    }
    class Confirms {
      requests:    Map<HandleId,
        oneshot::Sender<Decision>>
      next_handle: HandleId
      ' Gates engine generation:
      ' EngineClient checks
      ' is_clear() before pulling
      ' next request from queue.
    }
    class Clipboard
    class Messages <<persistent log — nvim-shaped>> {
      ring: VecDeque<MessageEntry>
      cap: 1024
      unread_errors: u32
      ' Pure data. Lua errors split into
      ' summary (1-line toast) + full
      ' (multi-line, traceback included).
      ' Toasts show summary; /messages
      ' opens a read-only viewer over
      ' the full bodies.
      --
      append(kind, source, full)
      list() -> Vec<MessageEntry>
      mark_read() / clear()
    }
    class Timers {
      set(ms, fn) -> TimerId
      set_interval(ms, fn) -> TimerId
      cancel(id)
      ' Built-in `now` cell ticked at 1s
      ' lives here. Plugin timers can
      ' drive their own cells.
    }
    class Cells <<reactive registry — also the event bus>> {
      Map<CellName, Box<dyn Any>>
      Cell<T> { value: T, prev: Option<T> }
      ' P9.h: subscribers receive
      ' (new, old) — eliminates
      ' "remember prior value"
      ' boilerplate.
      built-ins (declared in
        cells::events::register_builtins):
        state: now, spinner_frame,
          agent_mode, vim_mode, model,
          reasoning, confirms_pending,
          tokens_used, errors, cwd,
          session_title, branch
        events: history, turn_complete,
          turn_error, confirm_requested,
          confirm_resolved,
          session_started, session_ended,
          input_submit
      ' Additional event cells
      ' (session_before_compact|fork,
      ' message_start|end, etc.) are
      ' deferred — added on first
      ' consumer demand.
      --
      new<T>(name, initial) -> CellId
      get<T>(name) -> &T
      set<T>(name, T)        ' wakes loop;
                              ' notifies subs(new, old)
      subscribe(name, CbId)   ' sole observer
      glob_subscribe(pattern, CbId)
      ' Built-in name typing rejects
      ' undeclared names at set_dyn;
      ' user-namespaced names via
      ' smelt.cell.user("plug:foo").
    }
    class LuaShared <<shared state — lives in core>> {
      commands, keymaps,
      statusline_sources,
      tools, tool_defaults,    ' P9.y
      callbacks, tasks,
      task_inbox, json_inbox,
      providers, permission_rules,
      mcp_configs, settings_overrides
      ' Project trust state (P9.g) is
      ' a separate `core::trust` store
      ' (JSON-persisted SHA-256 hashes),
      ' not a LuaShared field.
    }

    class LuaTaskRuntime <<task runtime — lives in core>> {
      coroutine tasks
      cancel tokens (per-task,
        tagged with session id —
        cancel-on-mismatch enforces
        stale-context invalidation,
        P9.h)
      tool env
    }

    class PromptSections <<system-prompt assembly — tui>> {
      ' Lives in tui (not core) — used
      ' only by TuiApp before sending
      ' UiCommand::StartTurn.
      sections: Vec<(name, content)>
      set(name, content)
      remove(name)
      assemble() -> String
      ' Lua plugins write via
      ' smelt.prompt.set_section /
      ' remove_section. Source-register
      ' with deps was the P9.h sketch;
      ' the landed shape is a flat
      ' name→content map (no consumer
      ' for cell-driven re-eval).
    }
  }

  package "engine bridge" as EB #FFE9B5 {
    class EngineClient {
      owns EngineHandle + confirms gate
      recv() gates on Confirms::is_clear()
      drains event_rx → reducer/host calls
      TextDelta → Buffer.append
        (Rust-only; no Lua per chunk)
      ToolStarted/Finished, block end
        → Buffer attach `on_block` cb
      ' Provider middleware (P9.i) is
      ' deferred — speculative seam
      ' without a concrete consumer.
      ' Lands when first plugin needs
      ' redaction / A/B swap / cassette
      ' capture.
    }
    interface ProviderMiddleware <<P9.i — deferred>> {
      before_request(&mut ProviderRequest)
      after_response(&mut ProviderResponse)
    }
    class ProviderRequest <<neutral — P9.i, deferred>>
  }

  package "Rust capabilities  (generic, Lua-callable — FFI for intricate logic)" as BIND #FFE9B5 {
    class "core::process"      as TPROC      <<foreground spawn /\nstreaming / background\nregistry / kill — covers\nshort-lived + long-lived>>
    class "core::fs"           as TFS        <<read / write / edit (mtime-checked) / glob / lock>>
    class "core::http"         as THTTP      <<fetch / cache / redirects>>
    class "core::html"         as THTML      <<html → markdown>>
    class "core::notebook"     as TNB        <<Jupyter JSON ops>>
    class "core::grep"         as TGREP      <<ripgrep wrapper>>
    class "core::path"         as TPATH      <<normalize / canonical / relative>>
    class "core::fuzzy"        as TFUZZY     <<fuzzy matching / scoring>>
    class "core::permissions"  as TPERM      <<all permission policy:\nbash AST · pattern match ·\nworkspace path extract ·\nruntime approvals ·\nworkspace store (JSON)\n· generic subcommands\n  HashMap<String, RuleSet>>>
  }

  package "content data types  (pure data — zero terminal deps)" as CDATA #FFE9B5 {
    class Buffer <<lines + extmarks — core>> {
      lines, undo
      readonly: bool          ' data-layer edit guard.
                              ' True elides set_lines,
                              ' set_source, undo. The
                              ' overlay viewer fallthrough
                              ' auto-flips vim_mode to
                              ' Normal when the focused
                              ' leaf's buffer is readonly,
                              ' so /messages opens in
                              ' nav-only mode.
      namespaces, extmarks
      ' Pure data. Theme refs are
      ' highlight ids, not raw colors.
      ' Parsed metadata (LCS results,
      ' syntect tokens) lives in
      ' dedicated namespaces — no
      ' separate IR cache file.
      --
      attach(spec)            ' parser + on_block cb
                              ' (semantic boundaries,
                              ' not per-chunk)
      set_selection(ranges)   ' override selection paint
      selection() / clear_selection()
      yank_text_for_range(r)  ' walks extmark
                              ' YankSubst values
    }
    class Namespace <<NsId(u32) handle>> {
      ' Integer ids minted by
      ' Buffer::create_namespace(name).
      ' Same name returns same id
      ' (nvim semantics). Lua boundary
      ' exposes via smelt.api.
      ' create_namespace; built-ins
      ' under smelt.ns.*.
    }
    class Extmark <<keyset — nvim parity>> {
      start_row, start_col
      end_row, end_col
      payload: ExtmarkPayload
      priority
      right_gravity
      end_right_gravity        ' P9.f
    }
    enum ExtmarkPayload {
      Highlight
        ' { hl: HlGroup (P9.e), meta,
        '   hl_eol, hl_mode,
        '   conceal: Option<String> }
      Decoration
        ' (LineDecoration: fill_bg,
        '   virt_text overlay,
        '   click metadata, yank-subst)
      VirtText
        ' { text, hl_group,
        '   pos: VirtTextPos —
        '   Eol / Inline / Overlay /
        '   RightAlign }
    }
    ' sign_text / virt_lines / on_click /
    ' YankSubst remain sketches; not
    ' landed in `core::buffer` today.
    ' SpanMeta carries selectable, copy_as,
    ' source range, etc. — the per-cell
    ' metadata snapshots use for yank.
    interface BufferParser {
      parse(buf, input, width)
      ' Trait lives in core.
      ' Impls (markdown / diff /
      ' syntax / bash / block-variant)
      ' live in tui::content::
      ' transcript_parsers — they
      ' pull from tui-only
      ' highlight crates (syntect, …).
    }
  }
}

' =====================================================================
' crate: tui — terminal frontend (TuiApp + event loop + content rendering)
' =====================================================================
package "crate: tui  (terminal frontend)" as TUI #E0E8FF {

  class LuaRuntime <<mlua — full runtime>> {
    plugin scripts
    callback queue
    coroutine tasks
    TLS pointer to &mut Core
    tool registry + dispatch
    command registry
    cancel: cooperative —
      coroutine resumes with
      Err(Canceled)
    ' Wraps LuaShared + LuaTaskRuntime
    ' from core; adds tui-specific
    ' methods (tick_statusline,
    ' prepare_invocation, etc.).
    --
    autoload order (P9.g):
      1. embedded runtime/lua/smelt/
      2. ~/.config/smelt/init.lua
         + plugins/*.lua + tools/*.lua
      3. <cwd>/.smelt/init.lua
         + plugins/*.lua + tools/*.lua
         (gated by trust prompt)
    require search (P9.j):
      <cwd>/.smelt/runtime/?.lua →
      ~/.local/share/smelt/runtime/?.lua →
      embedded fallback. Override
      individual UX files without forking.
    auto-register (P9.g): files
      under tools/*.lua whose returned
      table has `name` + `run` register
      without an explicit
      smelt.tools.register call.
  }

  class TuiApp <<terminal frontend>> {
    core:           Core
    well_known:     WellKnown
    ui:             smelt_edit::Ui
    paint_registry: PaintRegistry
    --
    impl UiHost (compositor surface)
    Host-tier Lua flows through
    `&mut Core` directly — no
    parallel trait impl on TuiApp.
    resolve_leaf_id(raw: u64)
      -> Option<LeafKind>
  }

  class WellKnown <<well-known WinIds — TuiApp only>> {
    PROMPT_WIN      = WinId(0)
    TRANSCRIPT_WIN  = WinId(1)
    PROMPT_ABOVE_WIN = WinId(2)   ' top chrome leaf (above prompt)
    PROMPT_BELOW_WIN = WinId(3)   ' bottom chrome leaf (below prompt)
    cmdline:    Option<WinId>
    ' PROMPT_WIN / PROMPT_ABOVE / BELOW form a three-leaf
    ' layout for the prompt region (e44b4725).
  }

  class PaintRegistry <<Lua paint dispatch — tui only>> {
    PAINT_ID_BASE: u64 = 1<<32
    ' Allocates ids ≥ PAINT_ID_BASE.
    ' WinId range is 0..(1<<32)-1.
    ' No overlap enforced by debug-asserts.
    --
    register(cb: LuaCallback) -> PaintId
    unregister(id: PaintId)
    contains(id: PaintId) -> bool
  }

  enum LeafKind <<dispatch tag — tui only>> {
    Window(WinId)
    Paint(PaintId)
    ' Returned by TuiApp::resolve_leaf_id.
    ' Disambiguates the two halves of
    ' the u64 PaintId namespace.
  }

  ' Terminal-specific modules live here:
  ' content/  — transcript projection, prompt buffer, layout
  ' input/    — vim motions, prompt editing, completer
  ' events, render_loop, mouse, cmdline, status_bar
}

